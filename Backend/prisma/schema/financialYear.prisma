model FinancialYear {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String                    @db.Uuid
  year                  Int
  reportingDate         String
  startDate             String
  reviewStatus          ReviewStatus              @default(DRAFT)
  isLocked              Boolean                   @default(false)
  createdByUserId       String
  currentReviewerUserId String?
  finalizedByUserId     String?
  finalizedAt           DateTime?
  submittedAt           DateTime?
  lastEditedByUserId    String?
  isDeleted             Boolean                   @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  auditData             AuditData?
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator               User                      @relation("FinancialYearCreator", fields: [createdByUserId], references: [id])
  assignments           FinancialYearAssignment[]
  notesData             NotesData?
  reviewEvents          ReviewEvent[]

  @@map("financial_year")
}

model FinancialYearAssignment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialYearId String        @db.Uuid
  userId          String
  createdAt       DateTime      @default(now())
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, userId])
  @@map("financial_year_assignment")
}
